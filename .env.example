# Copy to .env and adjust if needed. All of these have working local
# defaults, so .env is optional for normal offline use.

PHARMACY_DB_URL=sqlite:///database/pharmacy.db
PHARMACY_CURRENCY=PKR
PHARMACY_INVOICE_PREFIX=INV
PHARMACY_LOW_STOCK_THRESHOLD=10
PHARMACY_EXPIRY_WARNING_DAYS=90
PHARMACY_SESSION_TIMEOUT_MIN=30
PHARMACY_BACKUP_RETENTION=14
